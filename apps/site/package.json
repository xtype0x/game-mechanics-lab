{
  "name": "@gml/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "pages": "node build/pages.mjs",
    "predev": "node build/pages.mjs",
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "prebuild": "node build/pages.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild:offline": "node build/pages.mjs",
    "build:offline": "tsc --noEmit && node build/offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort"
  },
  "dependencies": {
    "@gml/core": "*",
    "@gml/data-hsr": "*",
    "@gml/gacha-sim": "*",
    "@gml/hsr-battle": "*",
    "@gml/timing-lab": "*",
    "@gml/ui": "*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3"
  }
}
