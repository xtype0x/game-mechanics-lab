{
  "name": "gacha-game-tool",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ggt/console",
    "build": "npm run build -w @ggt/console",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/console --noEmit",
    "vectors": "node scripts/update-vectors.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
