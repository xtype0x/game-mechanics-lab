{
  "name": "game-mechanics-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gml/console",
    "build": "npm run build -w @gml/console",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/ui && tsc -p apps/console --noEmit && tsc -p apps/site",
    "vectors": "node scripts/update-vectors.mjs",
    "site:dev": "npm run dev -w @gml/site",
    "site:build": "npm run build -w @gml/site",
    "site:build:offline": "npm run build:offline -w @gml/site",
    "site:snapshot": "node apps/site/scripts/update-gacha-snapshot.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
